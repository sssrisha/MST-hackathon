# Example .env file for TenderGuard (copy to .env)

# SQLite database URL (default for MVP)
DATABASE_URL=sqlite:///./opentender.db

# JWT secret for FastAPI auth (replace with a strong random string)
JWT_SECRET=replace_with_a_strong_secret

# MST (or other EVM) RPC endpoint
MST_RPC_URL=http://127.0.0.1:8545

# Issuer registration key (32‑byte base64 string)
ISSUER_REGISTRATION_KEY=replace_with_32byte_base64_key
